{
  "name": "@astrale-os/cli",
  "version": "1.0.0-beta.47",
  "private": true,
  "description": "Astrale CLI — connect to existing Astrale kernels",
  "keywords": [
    "astrale",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Astrale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/cli.git"
  },
  "bin": {
    "astrale": "./dist/astrale.js"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "studio/server",
    "studio/shared",
    "studio/client/dist",
    "studio/package.json",
    "viewer/dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./connect-core": {
      "types": "./dist/types/connect-core.d.ts",
      "import": "./dist/public/connect-core.js",
      "default": "./dist/public/connect-core.js"
    },
    "./keys": {
      "types": "./dist/types/keys/index.d.ts",
      "import": "./dist/public/keys/index.js",
      "default": "./dist/public/keys/index.js"
    },
    "./paths": {
      "types": "./dist/types/paths/index.d.ts",
      "import": "./dist/public/paths/index.js",
      "default": "./dist/public/paths/index.js"
    },
    "./identity-export-v1.schema.json": "./src/identity/.spec/schemas/identity-export-v1.schema.json"
  },
  "scripts": {
    "prepare": "husky",
    "build": "bun scripts/build.ts",
    "prepack": "pnpm run package:check",
    "package:check": "pnpm run typecheck && pnpm run test && pnpm run build && node scripts/verify-public-exports.mjs && node scripts/verify-public-dependency-boundary.mjs",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.tests.json && tsgo --noEmit -p tsconfig.scripts.json && tsgo --noEmit -p viewer && pnpm --dir studio run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "test": "node scripts/qualification/source-boundary.mjs --target && bun test src studio/client/src studio/server studio/shared && node --test scripts/*.test.mjs",
    "test:skills-e2e": "node scripts/qualification/skills-update-e2e.mjs",
    "test:studio": "pnpm --dir studio test",
    "test:watch": "bun test --watch src",
    "qualification:ui-search": "bun scripts/qualification/ui-search-provider.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "commander": ">=13.0.0 <14.0.0",
    "jose": "^6.1.3",
    "ora": "^9.0.0",
    "ts-morph": "^25.0.1",
    "tsconfig-paths": "4.2.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrale-os/ox": ">=0.1.3 <1.0.0",
    "@astrale-os/sdk": "0.5.0-beta.64",
    "@astrale-os/shell": "0.4.2-beta.6",
    "@astrale/commitlint-config": "jsr:~2.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bun-types": "1.4.0",
    "husky": "~9.1.7",
    "lint-staged": "17.3.0",
    "msgpackr": "^2.0.5",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25 || >=26 <27",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.0.0"
}
