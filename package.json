{
  "name": "@astrale-os/cli",
  "version": "0.2.3",
  "description": "Astrale CLI - init, dev, build, and create commands for Astrale WebOS applications",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "astrale": "./bin/astrale.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/cli.git"
  },
  "scripts": {
    "preinstall": "node .check-workspace.cjs",
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "astrale",
    "cli",
    "webos"
  ],
  "author": "Astrale",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/keyring": "^1.1.6",
    "@astrale-os/datastore-client": ">=1.0.0 <2.0.0",
    "@astrale-os/kernel-api": ">=0.0.0 <1.0.0",
    "@astrale-os/kernel-client-ws": ">=0.0.0 <1.0.0",
    "@astrale-os/kernel-core": ">=0.0.0 <1.0.0",
    "@astrale-os/sdk-app": ">=0.0.0 <1.0.0",
    "@astrale-os/shell-core": ">=0.0.0 <1.0.0",
    "@astrale-os/shell-runtime": ">=0.0.0 <1.0.0",
    "@astrale-os/shell-transport": ">=0.0.0 <1.0.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": ">=13.0.0 <14.0.0",
    "esbuild": ">=0.25.0 <1.0.0",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@astrale/commitlint-config": "jsr:@astrale/commitlint-config@^1.0.0",
    "@astrale/eslint-config": "jsr:@astrale/eslint-config@^1.0.0",
    "@astrale/prettier-config": "jsr:@astrale/prettier-config@^1.0.0",
    "@astrale/typescript-config": "jsr:@astrale/typescript-config@^1.0.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.21.0"
  },
  "prettier": "@astrale/prettier-config",
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
