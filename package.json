{
  "name": "@astrale-os/cli",
  "version": "0.1.0",
  "description": "Astrale CLI - init, dev, build, and create commands",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "astrale": "./bin/astrale.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "astrale",
    "cli",
    "webos"
  ],
  "author": "Astrale",
  "license": "MIT",
  "dependencies": {
    "@astrale-os/kernel-client-ws": ">=0.1.0 <1.0.0",
    "@astrale-os/datastore-client": ">=1.0.0 <2.0.0",
    "@astrale-os/kernel-api": ">=0.1.0 <1.0.0",
    "@astrale-os/kernel-core": ">=0.1.0 <1.0.0",
    "@astrale-os/sdk-app": ">=0.1.0 <1.0.0",
    "@astrale-os/shell-transport": ">=0.1.0 <1.0.0",
    "commander": "^13.0.0",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.8.3"
  }
}
