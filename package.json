{
  "name": "@astrale-os/cli",
  "version": "0.3.0",
  "description": "Astrale CLI - init, dev, build, and create commands for Astrale WebOS applications",
  "keywords": [
    "astrale",
    "cli",
    "webos"
  ],
  "license": "MIT",
  "author": "Astrale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/cli.git"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "registry": "https://npm.pkg.github.com",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "preinstall": "node .check-workspace.cjs",
    "build": "tsgo",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint --fix -c oxlint.json .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrale-os/datastore-client": ">=1.0.0 <2.0.0",
    "@astrale-os/kernel-api": ">=0.0.0 <1.0.0",
    "@astrale-os/kernel-client-ws": ">=0.0.0 <1.0.0",
    "@astrale-os/kernel-core": ">=0.0.0 <1.0.0",
    "@astrale-os/sdk-app": ">=0.0.0 <1.0.0",
    "@astrale-os/shell-core": ">=0.0.0 <1.0.0",
    "@astrale-os/shell-runtime": ">=0.0.0 <1.0.0",
    "@astrale-os/shell-transport": ">=0.0.0 <1.0.0",
    "@astrale-os/ui": ">=0.0.0 <1.0.0",
    "@napi-rs/keyring": "^1.1.6",
    "@tailwindcss/postcss": "^4.0.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": ">=13.0.0 <14.0.0",
    "esbuild": ">=0.25.0 <1.0.0",
    "ora": "^9.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrale/commitlint-config": "jsr:@astrale/commitlint-config@~2.0.0",
    "@astrale/typescript-config": "jsr:@astrale/typescript-config@~1.1.0",
    "@commitlint/cli": "~20.3.1",
    "@commitlint/config-conventional": "~20.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@typescript/native-preview": "latest",
    "husky": "~9.1.7",
    "lint-staged": "~16.2.7",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "~6.0.1-rc"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "oxlint --fix -c oxlint.json",
      "oxfmt --write"
    ],
    "*.{json,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
