{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "description": "{{APP_NAME}} - Astrale app",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "init": "astrale init --title '{{APP_NAME}}' --kernel-url ws://localhost:8081 --avatar-id $AVATAR_ID --token $TOKEN",
    "dev": "astrale dev src/worker.ts --iframe-entry src/window/index.tsx",
    "build": "astrale build src/worker.ts --minify",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "author": "",
  "dependencies": {
    "@astrale-os/sdk-react": "workspace:*",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrale-os/cli": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "5.8.3"
  }
}
