# The studio's only @astrale-os dependency is @astrale-os/shell, which is published
# to PUBLIC npm. The parent cli/.npmrc scopes @astrale-os to GitHub Packages (for the
# CLI's kernel-* build deps), but the studio client build needs no private registry —
# resolve @astrale-os from public npm here so `cd studio && bun install` works in the
# standalone cli CI (the npm-publish job) without a GitHub Packages token. This only
# affects registry resolution; in the umbrella workspace @astrale-os/shell is still
# linked from source.
@astrale-os:registry=https://registry.npmjs.org
