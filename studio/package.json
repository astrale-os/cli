{
  "name": "@astrale-os/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Astrale Domain Studio — local GUI for authoring/inspecting a domain (launched by `astrale studio`)",
  "bin": {
    "astrale-studio": "./server/index.ts"
  },
  "files": [
    "server",
    "shared",
    "client/dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "bun server/index.ts",
    "dev:client": "vite",
    "test": "bun test client/src server shared",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@agentclientprotocol/sdk": "1.4.0",
    "@astrale-os/sdk": "0.5.0-beta.106",
    "@astrale-os/shell": "0.5.0-beta.11",
    "@dagrejs/dagre": "^3.0.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tisoap/react-flow-smart-edge": "^5.0.0",
    "@xyflow/react": "^12.4.4",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.11.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "ts-morph": "^25.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.5",
    "bun-types": "1.4.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.1"
  }
}
