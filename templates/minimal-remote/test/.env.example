# Copy to test/.env and fill in. test/.env is gitignored.
#
# For the default `local:inprocess` × `local:standalone:inprocess` pair,
# no variables are required — the scaffold test works out of the box.
#
# Fill in only when switching to a tunneled preset:

# MINIMAL_TUNNEL_ID=   # Cloudflare tunnel id fronting the worker (local:tunneled)
# KERNEL_TUNNEL_ID=    # Standalone-kernel tunnel id (local:standalone:tunneled)
# KERNEL_MANAGER_TUNNEL_ID=  # Manager tunnel id (local:manager:tunneled)
# DOMAIN_PORT=8787     # Override default wrangler dev port
# KERNEL_PORT=4500     # Override default standalone kernel port
