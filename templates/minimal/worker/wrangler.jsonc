{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrale-domain-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  // Uncomment when DNS for `astrale-domain.test.astrale.ai` exists on the
  // `astrale.ai` zone (see deploy.md → "Shipping to the shared
  // `*.test.astrale.ai` zone"). Until then, `workers_dev: true` lets you
  // deploy to the `*.workers.dev` subdomain for smoke testing.
  // "routes": [
  //   { "pattern": "astrale-domain.test.astrale.ai/*", "zone_name": "astrale.ai" }
  // ],
  // No `assets` binding: the minimal template has no SPA (no `/ui/*` surface).
  // The `default` template adds the Workers Assets binding for its React SPA.
}
