{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@types/bun", "@types/node"]
  },
  "include": ["bin", "src"],
  "exclude": ["templates", "**/__tests__/**", "src/lib/view/open-intent.ts"]
}
